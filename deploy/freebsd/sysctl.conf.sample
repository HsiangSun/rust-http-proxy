# rust-http-proxy —— FreeBSD 内核调优参考
#
# 把需要的行追加到 /etc/sysctl.conf，然后执行：
#   service sysctl restart        # 或重启系统
#
# 注意：这些不是必需的；请结合机器内存与业务并发量调整。

# ── 文件描述符 ────────────────────────────────────────────────────────────
kern.maxfiles=2097152
kern.maxfilesperproc=1048576

# ── 监听队列 / 三次握手 backlog ───────────────────────────────────────────
kern.ipc.somaxconn=65535

# ── 出向连接端口范围 ─────────────────────────────────────────────────────
net.inet.ip.portrange.first=1024
net.inet.ip.portrange.last=65535

# ── TCP keepalive（单位：毫秒） ───────────────────────────────────────────
net.inet.tcp.keepidle=300000
net.inet.tcp.keepintvl=30000
net.inet.tcp.keepcnt=3

# ── 小内存机器（如 2 核 512 MB） ──────────────────────────────────────────
# 默认每个 socket 的收发缓冲可自动增长到 2 MB（sendbuf_max / recvbuf_max），
# 几十条大流量连接就能占用数百 MB 内核内存。小内存机器取消下面两行注释，
# 封顶到 256 KB：对 API 类小请求没有影响，单连接大文件在高延迟链路上的吞吐
# 会受限（约 256 KB / RTT）。
#net.inet.tcp.sendbuf_max=262144
#net.inet.tcp.recvbuf_max=262144
